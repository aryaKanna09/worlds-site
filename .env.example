# Clerk (https://dashboard.clerk.com, see DEPLOY.md for provider setup)
# Frontend publishable key, safe for the client bundle.
VITE_CLERK_PUBLISHABLE_KEY=
# Backend secret key, server only, never expose.
CLERK_SECRET_KEY=

# Neon Postgres connection string (postgres://user:pass@host/db?sslmode=require)
DATABASE_URL=

# Ed25519 private key, PKCS8 PEM, single line with \n escapes.
# Generate with: node scripts/generate-keypair.mjs
TWINLAB_SIGNING_KEY=

# Resend API key for provisioning, acknowledgment, invite, and renewal emails.
RESEND_API_KEY=

# PostHog project key and host (https://us.i.posthog.com or https://eu.i.posthog.com)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

# Payments are stubbed; keep false until checkout is built.
BILLING_ENABLED=false

# Comma-separated list of emails allowed to view /admin/claims.
ADMIN_EMAILS=arya@usesparta.co
